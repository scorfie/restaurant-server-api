PORT=3000
NODE_ENV=development

# Supabase Postgres — pooled connection (port 6543, pgbouncer) used by the app at runtime
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Supabase Postgres — direct connection (port 5432, no pooler) used only by `prisma migrate`
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Used only by `npm run seed:admin` to bootstrap the first admin staff account
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
